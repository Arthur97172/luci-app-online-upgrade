#!/bin/sh
# Online-upgrade manual restore CGI
# Receives raw POST body (application/octet-stream), saves and extracts

TMPFILE="/tmp/manual-restore-backup.tar.gz"

# 直接读 stdin 的 POST body
cat > "$TMPFILE" 2>/dev/null

# 验证文件是否存在且非空
if [ ! -s "$TMPFILE" ]; then
	echo "Content-Type: text/plain; charset=utf-8"
	echo ""
	echo "ERROR:No file data received"
	rm -f "$TMPFILE"
	exit 0
fi

# 验证 gzip 格式
if ! gzip -t "$TMPFILE" 2>/dev/null; then
	echo "Content-Type: text/plain; charset=utf-8"
	echo ""
	echo "ERROR:Uploaded file is not a valid gzip archive"
	rm -f "$TMPFILE"
	exit 0
fi

# 执行恢复（tar xzf 到根目录）
cd / && tar xzf "$TMPFILE" 2>/dev/null
RV=$?
rm -f "$TMPFILE"

if [ $RV -eq 0 ]; then
	echo "Content-Type: text/plain; charset=utf-8"
	echo ""
	echo "OK:Configuration restored from the uploaded backup. Reboot the router to apply it."
else
	echo "Content-Type: text/plain; charset=utf-8"
	echo ""
	echo "ERROR:Restore failed; the backup file may be corrupted"
fi
