# LuCI configuration for online-upgrade

config online-upgrade 'settings'
	option enabled '0'
	option repo 'owner/repo'
	option tag 'tag'
	option direct_url ''
	option proxy 'https://ghfast.top/'
	option firmware_pattern 'auto'
	option reconnect_hosts '192.168.1.1 10.0.0.1 immortalwrt.lan openwrt.lan'
	option keep_config '1'
	option last_upgrade_version '0'
